<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.org/DTDs/PropertyList-1.0.dtd">
<!-- CR usage archive（AIR-206）——bridge jobs 的 code-reality 工具呼叫每日歸檔，08:20
     （patrol 08:10 之後、錯開 backlog cleanup）。形態照 dispatch-ledger-sweep 先例。
     行為主體＝scripts/cr_usage_archive.py（唯讀掃描 job jsonl、append 持久 sink
     ~/.local/share/cr-usage/events.jsonl；偵測與處置分離，只歸檔不分析）。
     路徑參數化：{{REPO}} 與 {{HOME}} 佔位，裝載前須 render（governance/install.py 同款）。
     安裝形態：render → cp ~/Library/LaunchAgents/com.ai-guide.cr-usage-archive.plist
     → launchctl bootstrap gui/$(id -u) <rendered>。
     注意：本註解禁 ASCII 雙連字號（XML comment 語法限制）。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-guide.cr-usage-archive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd {{REPO}} &amp;&amp; uv run python scripts/cr_usage_archive.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>PATH</key>
        <string>{{HOME}}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.local/share/cr-usage/archive.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.local/share/cr-usage/archive.err</string>

    <key>ThrottleInterval</key>
    <integer>600</integer>
</dict>
</plist>
