{
  "Notification": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/hooks/notification.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/hooks/stop-notification.sh",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/memory-index-regen.py"
          ],
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/post-build-gate.py"
          ],
          "timeout": 10
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/hooks/stop-notification.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "compact",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/compact-tail-inject.py"
          ]
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/memory-watch-seed.py"
          ]
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/block-python-c-comment.py"
          ]
        },
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/block-python-file-write.py"
          ]
        },
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/kanban-skill-gate.py"
          ],
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/block-memory-index-write.py"
          ],
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/marshal_admission_guard.py"
          ],
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/memory-write-sensor.py",
            "--source",
            "claude"
          ]
        }
      ]
    },
    {
      "matcher": "Read",
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/kanban-skill-gate.py"
          ],
          "timeout": 10
        }
      ]
    }
  ],
  "FileChanged": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{HOOK_PYTHON}}",
          "args": [
            "{{REPO}}/hooks/memory-dirty-sensor.py"
          ]
        }
      ]
    }
  ]
}
