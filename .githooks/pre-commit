#!/bin/bash
# 治理工具鏈測試閘門（T1-2）——確定性 git hook，非 /commit skill 內的 prompt 提示。
# 啟用：git config core.hooksPath .githooks（一次性，per-clone）
cd "$(dirname "$0")/.." || exit 1
# 控制面 canonical 隔離閘（AIR-106）——先於測試閘：main 上控制面路徑 commit 直接擋
bash "$(dirname "$0")/control-plane-guard.sh" || exit 1
# 開卡協議①機械閘 v2（135.5）——staged blob／rename-aware baseline／marker fail-closed（backlog fast-path 亦照跑）
python3 "$(dirname "$0")/card-diagram-guard.py" || exit 1
# 環境隔離：hook 由 git 執行時繼承 GIT_DIR/GIT_WORK_TREE 等 git 注入變數，
# 會把測試內的 git init 臨時 repo 導向錯誤位置——兩次 core.bare=true 污染
# 外層 repo 實證＋codex 弧 29 failed "must be run in a work tree"。
# 逐一 unset --local-env-vars 列出的變數（僅 git 注入的 GIT_* 類，
# 不含 PATH/HOME 等 hook 自身所需，清理安全）。
while IFS= read -r v; do
  unset "$v"
done < <(git rev-parse --local-env-vars)
# backlog fast path（AIR-125 AC#1）：staged diff 全屬 backlog/（特赦①②③場景的
# 機械對應）→ 跳 pytest 腿；control-plane-guard 與 py_compile 腿照跑。
# quotePath=false：卡檔名含非 ASCII，預設 octal-escape 會讓 prefix 判準失配
# （control-plane-guard.sh 同款教訓）。空 staged（手動直跑）採保守走全量。
staged="$(git -c core.quotePath=false diff --cached --name-only)"
if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qv '^backlog/'; then
  echo "[fast-path] staged 全屬 backlog/——跳過測試腿（guard＋py_compile 照跑）"
  python3 -m py_compile hooks/*.py skills/memory-audit/scripts/*.py .githooks/card-diagram-guard.py || exit 1
  exit 0
fi
# commit gate 模式標記（AIR-125 AC#2）：live drift 偵測測試據此 skip——
# 職責歸位：live drift 單一歸宿＝installer --check＋launchd monitor 日頻，不在 commit gate
export PRE_COMMIT=1
uv run pytest tests/ -q || exit 1
# hook runtime 是系統 python3（3.9）——機械擋 3.10+ 語法於 generator/hooks 部署面
python3 -m py_compile hooks/*.py skills/memory-audit/scripts/*.py .githooks/card-diagram-guard.py || exit 1
