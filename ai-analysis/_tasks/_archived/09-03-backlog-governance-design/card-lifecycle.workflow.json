    { "id": "out", "label": "執行與出口", "fromCol": 3, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["talk", "plan", "card", "open", "exec", "close", "done"],
  "nodes": [
    { "id": "talk", "lane": "board", "col": 0, "type": "external", "label": "對話結晶", "sublabel": "討論題·對話即載體", "width": 124 },
    { "id": "plan", "lane": "board", "col": 1, "type": "security", "label": "規模判定", "sublabel": "simple ↔ standard/full", "tag": "/execution-plan", "width": 124 },
    { "id": "card", "lane": "board", "col": 2, "type": "frontend", "label": "建卡 task create", "sublabel": "desc gate 三必有＋雙 ref", "width": 124 },
    { "id": "drift", "lane": "board", "col": 3, "type": "security", "label": "desc 漂移→修正", "sublabel": "如實化／F-1 回寫 desc", "width": 124 },
    { "id": "close", "lane": "board", "col": 4, "type": "backend", "label": "結案兩步", "sublabel": "Done＋final-summary", "width": 124 },
    { "id": "done", "lane": "board", "col": 5, "type": "database", "label": "Done 欄", "sublabel": "留板→completed/ 清場", "width": 124 },
    { "id": "draft", "lane": "work", "col": 1, "type": "database", "label": "draft 未承諾池", "sublabel": "未開 /execution-plan", "width": 124 },
    { "id": "ep", "lane": "work", "col": 2, "type": "backend", "label": "EP", "sublabel": "standard+ 才建·規劃層", "width": 124 },
    { "id": "open", "lane": "work", "col": 3, "type": "security", "label": "起手式", "sublabel": "讀卡知形態→新鮮度→雙 ref", "width": 124 },
    { "id": "exec", "lane": "work", "col": 4, "type": "frontend", "label": "執行", "sublabel": "卡直行／EP 段落", "width": 124 }
