    { "from": "draft", "to": "plan", "label": "promote" },
    { "from": "plan", "to": "card", "label": "simple：不建 EP", "variant": "emphasis" },
    { "from": "plan", "to": "ep", "label": "standard/full", "role": "branch" },
    { "from": "ep", "to": "card", "label": "建卡雙 ref 掛 EP" },
    { "from": "card", "to": "open", "label": "「做 AIR-N」接手" },
    { "from": "card", "to": "drift", "label": "快照過時", "role": "error", "variant": "security" },
    { "from": "open", "to": "exec" },
    { "from": "exec", "to": "close", "label": "完成" },
    { "from": "close", "to": "done" }
  ],
  "cards": [
    { "dot": "emerald", "title": "承諾時定形態——draft↔task 分界", "items": ["分界線＝有沒有開 /execution-plan：未開＝draft 未承諾池（想法捕獲/觸發型/session 斷）", "simple 不建 EP——卡 desc 過 gate 即 handoff；standard/full 寫 EP、卡雙 ref 掛 EP", "執行不分岔：讀卡知形態（有無 EP ref）；scope 漲→升 EP 是逃逸非分岔"] },
    { "dot": "rose", "title": "出口——有進有出", "items": ["結案兩步→卡留 Done 欄；completed/ 清場延到 maintain 週期", "過時卡走 archive/ 退場——可復活（AIR-4 先例）；draft 出口＝promote 或刪"] },
    { "dot": "cyan", "title": "漂移防護", "items": ["起手式核新鮮度：desc baseline vs git log——過時即對照範圍", "並行搶走→desc 如實化；F-1 型→決策層變更回寫 desc"] }
  ]
}
